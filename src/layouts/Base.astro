---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  article?: { title: string; date: Date; updated?: Date; };
  noindex?: boolean;
  canonicalPath?: string;
}
const { title, description = site.description, article, noindex = false, canonicalPath = Astro.url.pathname } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Data systems at scale, and the people behind them`;
const canonical = new URL(canonicalPath, site.url).href;
// Share picture for every page: the logo-with-text card in public/og-image.png.
const socialImage = new URL('/og-image.png', site.url).href;
const active = (path: string) => Astro.url.pathname === path;
const schema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description,
  datePublished: article.date.toISOString(),
  dateModified: (article.updated ?? article.date).toISOString(),
  mainEntityOfPage: canonical,
  image: socialImage,
  author: { '@type': 'Person', name: site.author, url: `${site.url}/about/` },
  publisher: { '@type': 'Person', name: site.author },
} : {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: site.name, url: site.url, description,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag (gtag.js). The standard snippet, plus Google's official opt-out flag off production. -->
    <script is:inline define:vars={{ gaId: site.analytics.googleId, gaHost: site.analytics.productionHost }}>
      if (location.hostname !== gaHost) window['ga-disable-' + gaId] = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', gaId, { anonymize_ip: true });
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.googleId}`}></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Coffee and Data" href="/feed.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee and Data logo: a kettle pouring data into a coffee brewer" />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:published_time" content={article.date.toISOString()} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- EXPERIMENT: sticky top bar. Compacts the bar once scrolled; remove with the CSS block in global.css. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const update = () => {
          const y = window.scrollY;
          // hysteresis: compact after 120px, expand only near the top, so it never flickers
          if (y > 120) root.classList.add('header-compact');
          else if (y < 20) root.classList.remove('header-compact');
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
      })();
    </script>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Coffee and Data home"><Image class="brand-mark" src={logoMark} alt="" height={56} densities={[1, 2]} loading="eager" /><span>Coffee and Data<span class="brand-caption">By Marc-Olivier Arsenault</span></span></a>
      <nav aria-label="Main navigation">
        <a href="/" aria-current={active('/') ? 'page' : undefined}>Writing</a>
        <a href="/about/" aria-current={active('/about/') ? 'page' : undefined}>About</a>
        <a class="nav-subscribe" href="/subscribe/" aria-current={active('/subscribe/') ? 'page' : undefined}>Subscribe <span aria-hidden="true">↗</span></a>
      </nav>
      {article && <div class="reading-progress" aria-hidden="true"><span></span></div>}
    </header>
    {article && (
      <script is:inline>
        // Reading progress: fills the green line under the top bar as the article body is read.
        // Runs once the article body exists (this script sits above it in the page).
        document.addEventListener('DOMContentLoaded', () => {
          const bar = document.querySelector('.reading-progress span');
          const body = document.querySelector('.prose');
          if (!bar || !body) return;
          let queued = false;
          const update = () => {
            queued = false;
            const box = body.getBoundingClientRect();
            const distance = box.height - window.innerHeight;
            const progress = distance > 0 ? Math.min(1, Math.max(0, -box.top / distance)) : 1;
            bar.style.transform = `scaleX(${progress})`;
          };
          const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
          update();
          window.addEventListener('scroll', schedule, { passive: true });
          window.addEventListener('resize', schedule);
        });
      </script>
    )}
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href="/">Coffee and Data<span aria-hidden="true">.</span></a><p>Independent writing by {site.author}.</p></div>
      <nav aria-label="Footer navigation">
        <a href={site.github}>GitHub ↗</a>
        <a href={site.linkedin}>LinkedIn ↗</a>
        <a href="/feed.xml">RSS ↗</a>
      </nav>
      <p class="copyright">© {new Date().getUTCFullYear()} {site.author}</p>
    </footer>
  </body>
</html>
