---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, postUrl, formatDate, readingTime, tagName, tagUrl } from '../lib/posts';
import { site } from '../lib/site';
const posts = await getPosts();
const featured = posts.find(post => post.data.featured) ?? posts[0];
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort((a, b) => tagName(a).localeCompare(tagName(b)));
const years = [...new Set(posts.map(post => post.data.pubDate.getUTCFullYear()))];
---
<Base>
  <div class="wrap">
    <header class="home-heading"><p class="eyebrow">An independent engineering notebook</p><h1>Coffee &amp; <em>Data.</em></h1><p>{site.description}</p><a class="text-link home-browse" href="#all-writing">Explore the notebook <span aria-hidden="true">↓</span></a></header>
    {featured && <section class="home-spotlight" aria-label="Featured writing">
      <div class="spotlight-meta"><p class="eyebrow">On the reading table</p><p><time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time><br />{readingTime(featured)} min read</p></div>
      <article><h2><a href={postUrl(featured)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><a class="text-link" href={postUrl(featured)}>Read the article <span aria-hidden="true">↗</span></a></article>
    </section>}
    <section class="home-archive" aria-labelledby="all-writing">
    <div class="section-heading"><h2 id="all-writing">All the field notes.</h2><p class="eyebrow">{posts.length} articles / Newest first</p></div>
    <div class="archive-tools">
      <form class="archive-search" role="search" hidden>
        <label for="post-search">Find an article</label>
        <input id="post-search" type="search" placeholder="Try SQL, warehouse, or data science" autocomplete="off" />
      </form>
      <ul class="tag-list" aria-label="Browse by topic">{tags.map(tag => <li><a href={tagUrl(tag)}>{tagName(tag)}</a></li>)}</ul>
    </div>
    <p class="search-status" role="status" hidden></p>
    <div class="archive">{years.map(year => <section data-year aria-labelledby={`year-${year}`}><h2 id={`year-${year}`}>{year}</h2><PostList posts={posts.filter(post => post.data.pubDate.getUTCFullYear() === year)} /></section>)}</div>
    </section>
  </div>
  <script>
    const form = document.querySelector<HTMLFormElement>('.archive-search');
    const input = document.querySelector<HTMLInputElement>('#post-search');
    const status = document.querySelector<HTMLParagraphElement>('.search-status');
    if (form && input && status) {
      form.hidden = false;
      form.addEventListener('submit', event => event.preventDefault());
      input.addEventListener('input', () => {
        const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
        let found = 0;
        document.querySelectorAll<HTMLElement>('[data-post]').forEach(row => {
          row.hidden = !terms.every(term => row.dataset.search?.includes(term));
          if (!row.hidden) found++;
        });
        document.querySelectorAll<HTMLElement>('[data-year]').forEach(year => {
          year.hidden = !year.querySelector('[data-post]:not([hidden])');
        });
        status.hidden = terms.length === 0;
        status.textContent = found ? `${found} article${found === 1 ? '' : 's'} found.` : 'No articles found. Try another search.';
      });
    }
  </script>
</Base>
